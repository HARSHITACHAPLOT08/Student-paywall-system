<section class="av-secure-view av-secure-view--fullscreen" data-current-user="<%= (currentUser && currentUser.name) ? currentUser.name.replace(/'/g, "\\'") : '' %>">
  <header class="av-secure-header av-secure-header--small">
    <div class="av-hero-header">
      <h1 class="av-logo-heading"><%= assignment.title %></h1>
      <p class="av-secure-meta">Requested by: <%= currentUser?.name || 'Guest' %></p>
    </div>
  </header>

  <div class="av-secure-frame av-secure-frame--full" style="position:relative;">
    <div class="secure-content secure-pdf-shell">
      <div class="secure-blocker"></div>
      <div id="secure-pdf-container" class="secure-pdf-container" aria-hidden="false"
           data-assignment-id="<%= assignment.id %>"
           data-viewer-token="<%= viewerToken %>">
        <!-- PDF.js canvas pages will be rendered here -->
      </div>
    </div>

    <div id="overlay-watermark" class="overlay-watermark" aria-hidden="true"></div>
  </div>
  <!-- PDF.js runtime (loaded from CDN) -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.min.js" crossorigin="anonymous"></script>
  <script src="/js/secure-view.js"></script>
</section>
